{
  "DailyOps": {
    "Binance": {
      "BaseUrl": "https://api.binance.com",
      "TopSymbols": 10,
      "PriceChangeThresholdPercent": 5,
      "RequestTimeoutSeconds": 30
    },
    "Sales": {
      "IncomingFolder": "data/incoming",
      "RevenueDropThresholdPercent": 20,
      "DetectDuplicates": true
    },
    "Reports": {
      "OutputFolder": "data/output"
    },
    "Email": {
      "Host": "",
      "Port": 587,
      "User": "",
      "Password": "",
      "From": "dailyops-bot@localhost",
      "To": "",
      "EnableSsl": true
    },
    "Scheduler": {
      "CronExpression": "0 30 7 * * ?"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
